# Production API (set your real host; see .env-prod.example)
BASE_URL=

# Billing — Android free; iOS paid in production.
ANDROID_BILLING_ENABLED=false
IOS_BILLING_ENABLED=true
IOS_BILLING_DEV_BYPASS=false
IOS_PRODUCT_MONTHLY=ai.billmate.monthly
IOS_PRODUCT_YEARLY=ai.billmate.annually
IOS_PRODUCT_LIFETIME=ai.billmate.pro
ANDROID_PRODUCT_MONTHLY=ai.billmate.monthly
ANDROID                                                                                                                                                                                     _PRODUCT_YEARLY=ai.billmate.annually
ANDROID_PRODUCT_LIFETIME=ai.billmate.pro

FREEMIUM_SALES_LIMIT=10
FREEMIUM_PURCHASE_LIMIT=10
FREEMIUM_EMPLOYEE_LIMIT=4
FREEMIUM_ITEM_LIMIT=30
FREEMIUM_CATEGORY_LIMIT=15
FREEMIUM_PAYMENT_METHOD_LIMIT=2
FREEMIUM_PARTY_ROLE_LIMIT=2
FREEMIUM_PARTY_PER_ROLE_LIMIT=10
FREEMIUM_PARTY_OTHER_ROLE_LIMIT=5
FREEMIUM_ORGANIZATION_LIMIT=1
FREEMIUM_REPORTS_REQUIRE_PREMIUM=true
FREEMIUM_BACKUP_REQUIRE_PREMIUM=true
FREEMIUM_PAYROLL_REQUIRE_PREMIUM=true
FREEMIUM_ATTENDANCE_REQUIRE_PREMIUM=true
FREEMIUM_STOCK_REQUIRE_PREMIUM=true
FREEMIUM_INVOICE_EXPORT_REQUIRE_PREMIUM=true
