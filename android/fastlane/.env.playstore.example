# Copy to android/fastlane/.env.playstore and adjust paths for your machine.
# Used by: bundle exec fastlane android deploy

FLUTTER_BIN=/path/to/flutter/bin/flutter
# Or: FLUTTER_ROOT=/path/to/flutter

PACKAGE_NAME=ai.biztrack
PLAY_STORE_JSON_KEY_FILE=keys/play-store-key.json

# production = live Play Store release (not internal/alpha/beta)
PLAY_STORE_TRACK=production

# completed = publish immediately to the selected track
# draft = upload only; finish rollout manually in Play Console
PLAY_STORE_RELEASE_STATUS=completed

ANDROID_ARTIFACT_PATH=../build/app/outputs/bundle/productionRelease/app-production-release.aab

# If Play Console blocks upload until exact-alarm policy is declared:
# Play Console → Policy → App content → Alarms and reminders → declare shift reminders.
